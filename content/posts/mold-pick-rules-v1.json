{
  "id": "mold-pick-rules-v1",
  "title": "点模的五种情况",
  "intro": "点模的五种情况",
  "updated": "2026-08-15T03:59:12.000Z",
  "private": false,
  "sections": [
    {
      "id": "s1",
      "title": "第一种：同机台可申领",
      "badge": "1",
      "blocks": [
        {
          "type": "h3",
          "text": "业务目的"
        },
        {
          "type": "p",
          "text": "找“上次就在本机台”的可点模具。"
        },
        {
          "type": "h3",
          "text": "上次机台"
        },
        {
          "type": "p",
          "text": "必须 = 排产线"
        },
        {
          "type": "h3",
          "text": "型号匹配"
        },
        {
          "type": "p",
          "text": "跨档：prdt_key ∈ 跨档表"
        },
        {
          "type": "h3",
          "text": "棒径"
        },
        {
          "type": "p",
          "text": "本棒径 或 new_urdiameter 跨棒径"
        },
        {
          "type": "h3",
          "text": "状态"
        },
        {
          "type": "p",
          "text": "可申领：10, 11, 210, 219, 83, 213, 52, 231"
        },
        {
          "type": "h3",
          "text": "结果数量"
        },
        {
          "type": "p",
          "text": "全部符合的条码，逗号拼接"
        },
        {
          "type": "h3",
          "text": "返回格式"
        },
        {
          "type": "p",
          "text": "sn1, sn2"
        }
      ]
    },
    {
      "id": "s2",
      "title": "第二种：异机台可申领",
      "badge": "2",
      "blocks": [
        {
          "type": "h3",
          "text": "业务目的"
        },
        {
          "type": "p",
          "text": "找“上次不在本机台 / 从未上机”的可点模具。"
        },
        {
          "type": "h3",
          "text": "上次机台"
        },
        {
          "type": "p",
          "text": "≠ 排产线，或为空"
        },
        {
          "type": "h3",
          "text": "型号匹配"
        },
        {
          "type": "p",
          "text": "同第一种（跨档：prdt_key ∈ 跨档表）"
        },
        {
          "type": "h3",
          "text": "棒径"
        },
        {
          "type": "p",
          "text": "同第一种（本棒径或跨棒径）"
        },
        {
          "type": "h3",
          "text": "状态"
        },
        {
          "type": "p",
          "text": "同第一种（可申领状态集）"
        },
        {
          "type": "h3",
          "text": "结果数量"
        },
        {
          "type": "p",
          "text": "全部符合的条码，逗号拼接"
        },
        {
          "type": "h3",
          "text": "返回格式"
        },
        {
          "type": "p",
          "text": "sn1, sn2"
        }
      ]
    },
    {
      "id": "s3",
      "title": "第三种：放宽机台（一出多例外）",
      "badge": "3",
      "blocks": [
        {
          "type": "h3",
          "text": "业务目的"
        },
        {
          "type": "p",
          "text": "自动点模：普通订单尽量放宽机台。"
        },
        {
          "type": "h3",
          "text": "上次机台"
        },
        {
          "type": "p",
          "text": "模孔数 < 3 不限机台；≥ 3 仍必须本机台"
        },
        {
          "type": "h3",
          "text": "型号匹配"
        },
        {
          "type": "p",
          "text": "同第一种（跨档）"
        },
        {
          "type": "h3",
          "text": "棒径"
        },
        {
          "type": "p",
          "text": "同第一种（本棒径或跨棒径）"
        },
        {
          "type": "h3",
          "text": "状态"
        },
        {
          "type": "p",
          "text": "同第一种（可申领状态集）"
        },
        {
          "type": "h3",
          "text": "结果数量"
        },
        {
          "type": "p",
          "text": "全部符合的条码，逗号拼接"
        },
        {
          "type": "h3",
          "text": "返回格式"
        },
        {
          "type": "p",
          "text": "sn1, sn2"
        }
      ]
    },
    {
      "id": "s4",
      "title": "第四种：送检料专用",
      "badge": "4",
      "blocks": [
        {
          "type": "h3",
          "text": "业务目的"
        },
        {
          "type": "p",
          "text": "送检料：只能用本型号送检模。"
        },
        {
          "type": "h3",
          "text": "上次机台"
        },
        {
          "type": "p",
          "text": "不看机台"
        },
        {
          "type": "h3",
          "text": "型号匹配"
        },
        {
          "type": "p",
          "text": "只认本型号 prdt_no = @prdt_no"
        },
        {
          "type": "h3",
          "text": "棒径"
        },
        {
          "type": "p",
          "text": "禁止跨棒径 is_spanroddia = 0，且只用 ur_diameter"
        },
        {
          "type": "h3",
          "text": "状态"
        },
        {
          "type": "p",
          "text": "同第一种（可申领状态集）"
        },
        {
          "type": "h3",
          "text": "结果数量"
        },
        {
          "type": "p",
          "text": "先全部送检模；没有则 TOP 2（孔少、产量高）"
        },
        {
          "type": "h3",
          "text": "返回格式"
        },
        {
          "type": "p",
          "text": "sn1, sn2"
        }
      ]
    },
    {
      "id": "s5",
      "title": "第五种：返修 / 上机“当前有模”",
      "badge": "5",
      "blocks": [
        {
          "type": "h3",
          "text": "业务目的"
        },
        {
          "type": "p",
          "text": "判断机台 + 仓库现在有没有模。"
        },
        {
          "type": "h3",
          "text": "上次机台"
        },
        {
          "type": "p",
          "text": "必须 = 当前线"
        },
        {
          "type": "h3",
          "text": "型号匹配"
        },
        {
          "type": "p",
          "text": "同第一种，允许跨档"
        },
        {
          "type": "h3",
          "text": "棒径"
        },
        {
          "type": "p",
          "text": "同第一种，允许跨棒径"
        },
        {
          "type": "h3",
          "text": "状态"
        },
        {
          "type": "p",
          "text": "在制 / 试模：签收、加热、上机、卸模、试模、试模取样"
        },
        {
          "type": "h3",
          "text": "结果数量"
        },
        {
          "type": "p",
          "text": "单线同第一种；多线按线分组"
        },
        {
          "type": "h3",
          "text": "返回格式"
        },
        {
          "type": "p",
          "text": "单线：sn1, sn2；多线：S1482:sn1; S1496:sn2"
        },
        {
          "type": "p",
          "text": "说明：CATEGORY 可写 工作/学习/娱乐 或 work/study/fun；也可用 栏目: 学习"
        }
      ]
    }
  ]
}
