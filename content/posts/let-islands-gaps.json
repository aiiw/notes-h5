        {
          "type": "p",
          "text": "fx"
        },
        {
          "type": "p",
          "text": "=LET( rng,   A2:A11, arr,   IFERROR(--rng, rng), keep,  (arr&lt;&gt;\"\") * (arr&lt;&gt;0), r,     FILTER(arr, keep, \"\"), s,     SORTBY(r, r, 1), same,  --(DROP(s,1) = DROP(s,-1)), chg,   VSTACK(1, 1-same), g,     SCAN(0, chg, LAMBDA(a,v,a+v)), HSTACK(s, g) )"
        },
